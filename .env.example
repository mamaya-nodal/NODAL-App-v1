# Las credenciales reales nunca se guardan en Git.
NEXT_PUBLIC_APP_ENV=local

# Lectura cripto de sólo consulta. Sin clave, la integración queda desactivada.
# Configurar el valor real exclusivamente en el servidor, nunca NEXT_PUBLIC_.
ALCHEMY_API_KEY=

# Valores publicables de Supabase. Cada ambiente debe usar su propio proyecto.
# No colocar aqui claves reales; deben vivir en .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Clave privada del servidor para el asistente de diagnóstico. Nunca usar NEXT_PUBLIC_.
OPENAI_API_KEY=sk_REPLACE_ME

# Clave exclusiva del backend para persistir inventarios de Ninja. Nunca usar
# NEXT_PUBLIC_ ni guardar el valor real en Git.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# URL publica canonica usada en enlaces temporales enviados por correo.
NODAL_APP_BASE_URL=https://nodal-app-preview.vercel.app

# Automatizacion privada que envia invitaciones e instalaciones de identidades.
IDENTITY_ONBOARDING_AUTOMATION_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
